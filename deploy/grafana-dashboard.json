      "targets": [
        {
          "expr": "node_hwmon_temp_celsius{instance=\"$instance\", job=~\"station-node-exporter\", chip=~\".*0000:00:18.*\"}",
          "legendFormat": "{{ sensor }}"
        }
      ]
    },
