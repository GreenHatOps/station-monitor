      "id": 105,
      "title": "Network",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "bps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "id": 50,
      "title": "Network Traffic",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{instance=\"$instance\", job=~\"station-node-exporter\", device!~\"lo|docker.*|veth.*|br-.*\"}[1m]) * 8",
          "legendFormat": "{{ device }} RX"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{instance=\"$instance\", job=~\"station-node-exporter\", device!~\"lo|docker.*|veth.*|br-.*\"}[1m]) * 8",
          "legendFormat": "{{ device }} TX"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "id": 51,
      "title": "Network Errors & Drops",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(node_network_receive_errs_total{instance=\"$instance\", job=~\"station-node-exporter\", device!~\"lo|docker.*|veth.*\"}[1m])",
          "legendFormat": "{{ device }} RX errors"
        },
        {
          "expr": "rate(node_network_transmit_errs_total{instance=\"$instance\", job=~\"station-node-exporter\", device!~\"lo|docker.*|veth.*\"}[1m])",
          "legendFormat": "{{ device }} TX errors"
        },
        {
          "expr": "rate(node_network_receive_drop_total{instance=\"$instance\", job=~\"station-node-exporter\", device!~\"lo|docker.*|veth.*\"}[1m])",
          "legendFormat": "{{ device }} RX drops"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 50 },
      "id": 106,
      "title": "System Events",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 51 },
      "id": 60,
      "title": "Load Average",
      "type": "timeseries",
      "targets": [
        {
          "expr": "node_load1{instance=\"$instance\", job=~\"station-node-exporter\"}",
          "legendFormat": "1m"
        },
        {
          "expr": "node_load5{instance=\"$instance\", job=~\"station-node-exporter\"}",
          "legendFormat": "5m"
        },
        {
          "expr": "node_load15{instance=\"$instance\", job=~\"station-node-exporter\"}",
          "legendFormat": "15m"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 70 },
            { "color": "red", "value": 90 }
          ]},
          "unit": "percent",
          "custom": { "displayMode": "gradient-gauge" }
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 51 },
      "id": 61,
      "title": "Filesystem Usage",
      "type": "bargauge",
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "(1 - (node_filesystem_avail_bytes{instance=\"$instance\", job=~\"station-node-exporter\", fstype=~\"ext4|xfs|btrfs|zfs\"} / node_filesystem_size_bytes{instance=\"$instance\", job=~\"station-node-exporter\", fstype=~\"ext4|xfs|btrfs|zfs\"})) * 100",
          "legendFormat": "{{ mountpoint }}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 51 },
      "id": 62,
      "title": "Context Switches & Interrupts",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(node_context_switches_total{instance=\"$instance\", job=~\"station-node-exporter\"}[1m])",
          "legendFormat": "context switches/s"
        },
        {
          "expr": "rate(node_intr_total{instance=\"$instance\", job=~\"station-node-exporter\"}[1m])",
          "legendFormat": "interrupts/s"
        }
      ]
    }
  ],
